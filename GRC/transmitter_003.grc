- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: bytes to packets block\n\"\"\"\n\
      \nfrom random import randbytes\nimport pmt\nfrom pathlib import Path\nimport\
      \ base64\n\nfrom reedsolo import RSCodec\nfrom gnuradio import gr\nimport numpy\
      \ as np\n\n\ndef importFileFromPath(path):\n    \"\"\"import file as binary\n\
      \n    Args:\n        path (str): file path\n\n    Returns:\n        data (bytes):\
      \ output file\n    \"\"\"\n    with open(path, 'rb') as f:\n        data = f.read()\n\
      \    return data\n\n\ndef split_into_chuncks(data, chunck_size):\n    \"\"\"\
      takes some binary data and split it into chuncks\n\n    Args:\n        data\
      \ (bytes): input data\n        chunck_size (int): chunck size in bytes\n\n \
      \   Yields:\n        bytes: chunck\n    \"\"\"\n    for i in range(0, len(data),\
      \ chunck_size):\n        yield data[i:i + chunck_size]\n\n\n\ndef binary_to_encoded_packet(binaryFile,\n\
      \                             packet_size=64,\n                            \
      \ preamble_size = 3,\n                             postamble_size = 3,\n   \
      \                          ecc_size=6,\n                             id_len=2,\n\
      \                             data_len=1,\n                             verbose=False):\n\
      \    \"\"\"takes a binary file and split it into encoded packets.\n\n    each\
      \ packet is formatted like so, before Reed Solomon Encoding:\n    [ID, data_length,\
      \ data]\n\n    Args:\n        binaryFile (bytes, str): input binary file\n \
      \       packet_size (int, optional): total packet size in bytes. Defaults to\
      \ 64.\n        preamble_size(int, optionnal): preamble size in packet.\n   \
      \     postamble_size(int, optionnal): postamble size in packet.\n        ecc_size\
      \ (int, optional): Error Correction Code length. Defaults to 5.\n        id_len\
      \ (int, optional): id descriptor length. (With 2 bytes, 65535 packet can be\
      \ identified at most). Defaults to 2.\n        data_len (int, optional): data\
      \ length descriptor length. (with 1 byte, max packet size is 255). Defaults\
      \ to 1.\n        verbose (bool, optional): if true, you get to know the ecc\
      \ performance.\n    Returns:\n        output (np.uint8): output packets\n  \
      \  \"\"\"\n    if isinstance(binaryFile, str):\n        path = Path(binaryFile)\n\
      \        if path.is_file():\n            binaryFile = importFileFromPath(path)\n\
      \        else:\n            raise FileExistsError\n    elif isinstance(binaryFile,\
      \ bytes):\n        pass\n    else:\n        raise TypeError\n\n    ecc = RSCodec(ecc_size)\n\
      \    ecc.maxerrata(verbose=verbose)\n\n    binaryFile = base64.urlsafe_b64encode(binaryFile)\n\
      \n    chuncks = split_into_chuncks(binaryFile,\n                           \
      \      packet_size - ecc_size - id_len - data_len)\n    \n    preamble = [(0).to_bytes(id_len,\
      \ 'big') + randbytes(packet_size - id_len - ecc_size)] * preamble_size\n   \
      \ postamble = [(0).to_bytes(id_len, 'big') + b'eof' + randbytes(packet_size\
      \ - id_len - ecc_size -3)] * postamble_size\n\n    chunck_with_id = [(i+1).to_bytes(id_len,\
      \ 'big') + len(c).to_bytes(data_len, 'big') + c\n                      for i,\
      \ c in enumerate(chuncks)]\n\n    while len(chunck_with_id[-1]) < packet_size\
      \ - ecc_size:\n        chunck_with_id[-1] += randbytes(1)\n\n    # adding the\
      \ preamble and postamble\n    chunck_with_id = preamble + chunck_with_id + postamble\n\
      \n    encoded_chuncks = [ecc.encode(c) for c in chunck_with_id]\n\n    output\
      \ = [np.frombuffer(ec, dtype=np.uint8) for ec in encoded_chuncks]\n\n    return\
      \ output\n\n\nclass blk(gr.basic_block):\n    def __init__(self,\n         \
      \        input_binary=randbytes(1000),\n                 packet_size=64,\n \
      \                preamble_size=3,\n                 postamble_size=3,\n    \
      \             ecc_size=6,\n                 id_len=2,\n                 data_len=1):\n\
      \        gr.basic_block.__init__(\n            self,\n            name='Binary\
      \ to Packet',\n            in_sig=None,\n            out_sig=[np.uint8]\n  \
      \      )\n        self.packet_size = packet_size\n        self.out_packets =\
      \ binary_to_encoded_packet(binaryFile=input_binary,\n                      \
      \                              packet_size=packet_size,\n                  \
      \                                  preamble_size=preamble_size,\n          \
      \                                          postamble_size=postamble_size,\n\
      \                                                    ecc_size=ecc_size,\n  \
      \                                                  id_len=id_len,\n        \
      \                                            data_len=data_len)\n        self.preamble_size\
      \ = preamble_size\n        self.postamble_size = postamble_size\n\n        self.id_len\
      \ = id_len\n        self.current_packet_index = 0\n        self.indx = 0\n \
      \       self.packet_count = len(self.out_packets)\n        self.eof = False\n\
      \n    def get_state(self, idx):\n        if idx < self.preamble_size:\n    \
      \        return \"preamble\"\n        elif self.preamble_size <= idx < self.packet_count\
      \ - self.postamble_size:\n            return \"data\"\n        elif self.packet_count\
      \ - self.postamble_size <= idx < self.packet_count:\n            return \"postamble\"\
      \n        else:\n            return \"idle\"\n\n    def general_work(self, input_items,\
      \ output_items):\n        if not self.eof:\n            if self.current_packet_index\
      \ < self.packet_count:\n                current_packet = self.out_packets[self.current_packet_index]\n\
      \                output_items[0][:self.packet_size] = current_packet\n     \
      \           gr.log_debug.info(f\"sending packet {self.current_packet_index}.\
      \ {self.get_state(self.current_packet_index)}\")\n\n                self.indx\
      \ += self.packet_size\n                self.current_packet_index += 1\n    \
      \            self.produce(0, self.packet_size)\n                return 0\n \
      \           else:\n                self.eof = True\n                gr.log_debug.info(\"\
      EOF\")\n                return 0\n        else:\n            return 0\n\n\n\
      if __name__ == \"__main__\":\n    test = blk()"
    affinity: ''
    alias: ''
    comment: ''
    data_len: '1'
    ecc_size: '10'
    id_len: '2'
    input_binary: input_file_path
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_size: packet_size
    postamble_size: '6'
    preamble_size: '3'
  states:
