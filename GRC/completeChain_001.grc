      \\xd2\\x8c\\xaa\\xf4Y\\xde\\xdfI%\\x7fur\\xefP\\x97\\xae\\xbeWc)OQ\\xd19\\xf0\\x01w\\xd2*\\x93q\\x06VC\\x97%\\xb5\\xcd2\\x16\\x0e\\x83
      \\xb6s\\x96\\x19Sc\\xb7\\xe0\\xeaf\\x1d\\xc6\\xd1\\xad\\x16\\x81\\xd7\\x1f\\xd9\\xd278\\x0b\\xa4-`UT\\x1e`4\\xbd\\xbf\\x8d\\x1d\\x84w\\xc5`V)/\\x1deOp\\xc8\\x03\\xbf\\xc0\\xfbx&\\x80\\x0fl\\xf8\\xa2\\x8f\\x92\\xf2\\x9fp\\xce\\xa4k\\xcbA\\xf48ZH\\xce;K\\xa1\\x8e\\\'\\xa6Vt\\x8a\\x8ef\\xbd;\\xe8zE(T+\\\'^\\\\\\xba\\xa7S\\x0bJ\\xa5\\x84\\xb1\\x04\\x9e#bs\\x00\\xfdF\\xe4j9&\\rw:\\x85,\\xd1\\x17\\xfc[m>\\xf0\\xf4\\xbb\\xef\\xfaM\\xe6\\x18\\xf6XZ\\t\\xaa\\xc8\\x19\\xce\\xde\\xc041!\\xb2\\x9a\\\'\\xe0\\x0e\\x86\\x7f\\xcf\\xdc\\x99u\\x84\\xef;\\x08I\\x96"L\\xce\\x8bPn\\xadR\\xdb\\xe5\\xf9b;\\xf2\\xe9RB\\x00\\xba\\x1dcE\\xf4(\\xf3\\x16xn\\xff\\xcb\\x9c\\xa7[u\\x97\\xcc\\x82\\xe3\\x03\\xad\\x18\\x01\\xd4\\xc2H0\\x88E\\x96\\x0c,\\xbb\\xc4\\x7fq(\\x04-@#\\\'\\x0e\\xb9\\x83voh\''),
      ('packet_size', '64'), ('preamble_size', '3'), ('postamble_size', '3'), ('ecc_size',
      '6'), ('id_len', '2'), ('data_len', '1')], [], [('0', 'byte', 1)], '', ['packet_size'])
