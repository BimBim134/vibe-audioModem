- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport warnings\n\nimport\
      \ numpy as np\nfrom gnuradio import gr\nfrom reedsolo import RSCodec, ReedSolomonError\n\
      \ndef decode_single_packet(packet,\n                         ecc,\n        \
      \                 id_len,\n                         data_len):\n    \"\"\"takes\
      \ a single packet and decode it.\n\n    Args:\n        packet (bytes): input\
      \ packet\n        ecc (RSCodec): Reed Solomon Encoder\n        id_len (int):\
      \ id descriptor length\n        data_len (int): data length descriptor length\n\
      \n    Returns:\n        id, data (int, bytes): packet id, packet data\n    \"\
      \"\"\n    try:\n        decoded_packet = ecc.decode(packet)[0]\n        id =\
      \ int.from_bytes(decoded_packet[:id_len], 'big') - 1\n        if id == -1: #\
      \ filter out the preamble and postamble\n            if (packet[id_len:id_len+3]\
      \ - np.array([101, 111, 102])).sum() == 0 :\n                return (-1, b'eof')\n\
      \        else:\n            d_len = int.from_bytes(decoded_packet[id_len:id_len\
      \ + data_len], 'big')\n            return (id, decoded_packet[id_len + data_len:id_len\
      \ + data_len + d_len])\n    except ReedSolomonError as e:\n        warnings.warn(\"\
      packet is corrupted beyond repair !\")\n        print(e)\n    except TypeError:\n\
      \        pass\n    return (-1, b'')\n\nclass blk(gr.basic_block):  # other base\
      \ classes are basic_block, decim_block, interp_block\n    def __init__(self,\n\
      \                 out_filename='',\n                 packet_size=64,\n     \
      \            ecc_size=6,\n                 id_len=2,\n                 data_len=1,\n\
      \                 verbose=False):\n        gr.sync_block.__init__(\n       \
      \     self,\n            name='Binary to Packet',\n            in_sig=[np.uint8],\n\
      \            out_sig=None\n        )\n        self.out_filename = out_filename\n\
      \        self.packet_size = packet_size\n        self.ecc = RSCodec(ecc_size)\n\
      \        self.ecc.maxerrata(verbose=verbose)\n        self.id_len = id_len\n\
      \        self.data_len = data_len\n\n        self.packets = {}\n\n        self.indx\
      \ = 0\n        self.packet_count = 0\n        self.eof = False\n    \n    def\
      \ save_file(self):\n        data = dict(sorted(self.packets.items()))\n\n  \
      \      received_ids = set(data.keys())\n        check_id = set(range(len(data)))\n\
      \        if received_ids != check_id:\n            warnings.warn(\"data may\
      \ be incomplete !\", BytesWarning)\n\n        data = list(data.values())\n \
      \       with open(self.out_filename, 'wb') as f:\n            f.write(b''.join(data))\n\
      \n    def work(self, input_items, output_items):\n        if not self.eof:\n\
      \            for p in input_items[0][:]:\n                id, packet_data =\
      \ decode_single_packet(p,\n                                                \
      \       self.ecc,\n                                                       self.id_len,\n\
      \                                                       self.data_len)\n   \
      \             self.indx += len(packet_data)\n                self.consume(0,\
      \ len(packet_data))\n                gr.log_debug.info(f\"receiving {len(packet_data)}\"\
      )\n                \n                if not id == -1:\n                    #\
      \ saving data\n                    self.packet[id] = packet_data\n         \
      \       else:\n                    # checking if it is EOF\n               \
      \     if packet_data == b'eof':\n                        self.eof = True\n \
      \                       break\n            return 0\n        else:\n       \
      \     gr.log_debug(f'saving file to {self.out_filename}')\n            self.save_file()\n\
      \            return 0\n"
    affinity: ''
    alias: ''
    comment: ''
    data_len: '1'
    ecc_size: '6'
    id_len: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    out_filename: '"/home/bimbim/Codes/vibe_5/GRC/test_out/test.txt"'
    packet_size: '64'
    verbose: 'False'
  states:
    _io_cache: ('Binary to Packet', 'blk', [('out_filename', "''"), ('packet_size',
      '64'), ('ecc_size', '6'), ('id_len', '2'), ('data_len', '1'), ('verbose', 'False')],
      [('0', 'byte', 1)], [], '', ['data_len', 'id_len', 'out_filename', 'packet_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 144.0]
    rotation: 0
    state: enabled

