- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: bytes to packets block\n\"\"\"\n\
      \nfrom random import randbytes\nimport pmt\nfrom pathlib import Path\n\nfrom\
      \ reedsolo import RSCodec\nfrom gnuradio import gr\nimport numpy as np\n\n\n\
      def importFileFromPath(path):\n    \"\"\"import file as binary\n\n    Args:\n\
      \        path (str): file path\n\n    Returns:\n        data (bytes): output\
      \ file\n    \"\"\"\n    with open(path, 'rb') as f:\n        data = f.read()\n\
      \    return data\n\n\ndef split_into_chuncks(data, chunck_size):\n    \"\"\"\
      takes some binary data and split it into chuncks\n\n    Args:\n        data\
      \ (bytes): input data\n        chunck_size (int): chunck size in bytes\n\n \
      \   Yields:\n        bytes: chunck\n    \"\"\"\n    for i in range(0, len(data),\
      \ chunck_size):\n        yield data[i:i + chunck_size]\n\n\n\ndef binary_to_encoded_packet(binaryFile,\n\
      \                             packet_size=64,\n                            \
      \ preamble_size = 3,\n                             postamble_size = 3,\n   \
      \                          ecc_size=6,\n                             id_len=2,\n\
      \                             data_len=1,\n                             verbose=False):\n\
      \    \"\"\"takes a binary file and split it into encoded packets.\n\n    each\
      \ packet is formatted like so, before Reed Solomon Encoding:\n    [ID, data_length,\
      \ data]\n\n    Args:\n        binaryFile (bytes, str): input binary file\n \
      \       packet_size (int, optional): total packet size in bytes. Defaults to\
      \ 64.\n        preamble_size(int, optionnal): preamble size in packet.\n   \
      \     postamble_size(int, optionnal): postamble size in packet.\n        ecc_size\
      \ (int, optional): Error Correction Code length. Defaults to 5.\n        id_len\
      \ (int, optional): id descriptor length. (With 2 bytes, 65535 packet can be\
      \ identified at most). Defaults to 2.\n        data_len (int, optional): data\
      \ length descriptor length. (with 1 byte, max packet size is 255). Defaults\
      \ to 1.\n        verbose (bool, optional): if true, you get to know the ecc\
      \ performance.\n    Returns:\n        output (np.uint8): output packets\n  \
      \  \"\"\"\n    if isinstance(binaryFile, str):\n        path = Path(binaryFile)\n\
      \        if path.is_file():\n            binaryFile = importFileFromPath(path)\n\
      \        else:\n            raise FileExistsError\n    elif isinstance(binaryFile,\
      \ bytes):\n        pass\n    else:\n        raise TypeError\n\n    ecc = RSCodec(ecc_size)\n\
      \    ecc.maxerrata(verbose=verbose)\n\n    chuncks = split_into_chuncks(binaryFile,\n\
      \                                 packet_size - ecc_size - id_len - data_len)\n\
      \    \n    preamble = [(0).to_bytes(id_len, 'big') + randbytes(packet_size -\
      \ id_len - ecc_size)] * preamble_size\n    postamble = [(0).to_bytes(id_len,\
      \ 'big') + randbytes(packet_size - id_len - ecc_size)] * postamble_size\n\n\
      \    chunck_with_id = [(i+1).to_bytes(id_len, 'big') +\n                   \
      \   len(c).to_bytes(data_len, 'big') + c\n                      for i, c in\
      \ enumerate(chuncks)]\n\n    while len(chunck_with_id[-1]) < packet_size - ecc_size:\n\
      \        chunck_with_id[-1] += randbytes(1)\n\n    # adding the preamble and\
      \ postamble\n    chunck_with_id = preamble + chunck_with_id + postamble\n\n\
      \    encoded_chuncks = [ecc.encode(c) for c in chunck_with_id]\n\n    output\
      \ = [np.frombuffer(ec, dtype=np.uint8) for ec in encoded_chuncks]\n\n    return\
      \ output\n\n\nclass blk(gr.basic_block):\n    def __init__(self,\n         \
      \        input_binary=randbytes(1000),\n                 packet_size=64,\n \
      \                preamble_size=3,\n                 postamble_size=3,\n    \
      \             ecc_size=6,\n                 id_len=2,\n                 data_len=1):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Binary\
      \ to Packet',\n            in_sig=None,\n            out_sig=[np.uint8]\n  \
      \      )\n        self.packet_size = packet_size\n        self.out_packets =\
      \ binary_to_encoded_packet(binaryFile=input_binary,\n                      \
      \                              packet_size=packet_size,\n                  \
      \                                  preamble_size=preamble_size,\n          \
      \                                          postamble_size=postamble_size,\n\
      \                                                    ecc_size=ecc_size,\n  \
      \                                                  id_len=id_len,\n        \
      \                                            data_len=data_len)\n        self.current_packet_index\
      \ = 0\n        self.indx = 0\n        self.packet_count = len(self.out_packets)\n\
      \        self.eof = False\n\n    def work(self, input_items, output_items):\n\
      \        if not self.eof:\n            if self.current_packet_index < self.packet_count:\n\
      \                current_packet_size = len(self.out_packets[self.current_packet_index])\n\
      \                output_items[0][:current_packet_size] = self.out_packets[self.current_packet_index]\n\
      \n                key = pmt.intern(\"packet_len\")\n                val = pmt.from_long(current_packet_size)\n\
      \                self.add_item_tag(0,  # Write to output port 0\n          \
      \                      self.indx,   # Index of the tag\n                   \
      \             key,   # Key of the tag\n                                val,\n\
      \                                srcid=pmt.PMT_F)\n                \n      \
      \          gr.log_debug.info(f\"sending {current_packet_size} bytes\")\n   \
      \             self.indx += current_packet_size\n                self.current_packet_index\
      \ += 1\n                self.produce(0, current_packet_size)\n             \
      \   return current_packet_size\n            else:\n                self.eof\
      \ = True\n                gr.log_debug.info(\"EOF\")\n                return\
      \ 0\n        else:\n            return 0\n\n\nif __name__ == \"__main__\":\n\
      \    \n    test = blk()\n"
    affinity: ''
    alias: ''
    comment: ''
    data_len: '1'
    ecc_size: '6'
    id_len: '2'
    input_binary: '"/home/bimbim/Codes/vibe_5/sampleFile.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_size: '64'
    postamble_size: '3'
    preamble_size: '3'
  states:
    _io_cache: '(''Binary to Packet'', ''blk'', [(''input_binary'', ''b\''\\x10\\xf5\\xef9\\x10\\t\\xab\\xdf^\\x13\\xc17\\xefL\\xd0\\xcf\\xbc_\\t\\xc6\\r\\x9f=\\x86\\x13\\x80\\x04\\xb2\\x9c\\x9d\\xe2\\n\\xd1\\x18E\\xec`\\rn\\x1c\\x15Dc\\xf3L\\x01fS\\x0e\\xde\\x01+u\\xadI[\\x1b)\\xc5\\xe6\\xe1\\x86\\xcc\\xa0\\xfc\\x1f\\xabZ\\xcaz\\xd1\\x92\\\''L\\x00\\xb1\\x08\\xe6\\x1eV\\x94z\\xa1\\x9c\\x9a-\\xa3\\xea7\\xeffU\\xe5L)\\xea6q\\x15\\x88\\xd71\\xca\\xe4*\\xde\\xf29\\x1a2\\x1b\\xdc\\xc8\\xde\\xed\\xfb\\xed\\xf7\\x02xN\\x13\\xfe\\x97\\xa2).\\x93\\xe1\\xc3\\x18\\xed\\x94\\x85I\\xe4\\xc7\\x8f\\xe4\\x81\\x9c\\x85m\\x96\\x920\\x96\\x1f\\xd6\\x8f\\xf7\\xc9\\x82(>C\\xf0J\\\''\\x8e,kz(,/\\x99\\x9d\\xc5\\xa4zIpJD\\xca\\x1a@y\\xd3\\xfd\\xa4\\x82i\\xa7\\x80>~!\\xb5\\x9bXO\\x1fy\\x8f:
      \\xc5\\xc7\\xc3I\\x15\\xda\\xc2\\tn\\xa2By(m\\xc5\\xc5\\xac)\\xa5\\xa5\\xdf\\xf7\\x1a=%4\\xa4\\x90\\x93\\xb3\\xb4i\\xc9\\xac<\\xf2\\xfa\\x05\\x1f\\xdex\\x8d\\xf9S\\xe9p\\xb7)p2y\\x7f\\xd8\\xd5\\x96a\\xa5,\\x9a\\x86,\\x90\\xdb\\xfd*\\xae\\xfc~\\xf8\\x80\\xa6t\\xd4Gg\\x88%Q\\xa6wA\\x80\\xb5E\\x1b\\xd4ay\\xc1\\xa0\\xeee\\xe3\\x95\\xb6\\x13F(\\xd3RQ\\xc2\\x11\\xd0u\\x16\\x1al\\xf9\\xc59yQ\\x07\\x8d&kX\\xc0\\xe6\\xd6\\xb4\\xc1\\xb7\\xb4\\xf3\\xc8\\x9d\\xef\\x9d\\xf9]\\x03$u\\x1bN\\xd9\\xef\\xb4\\x87\\xb1e<{\\xc0\\xca\\x9a\\xe8\\xc7\\xa5\\x19\\x86\\xbc\\xc6\\xd2\\xf9\\xc0\\xc2\\xc6%\\xf3\\xe7v\\xa1\\xdbv"\\x89\\xef\\xae|Yi\\xb2\\xa5\\x84S7G\\x923m\\xaf\\xf9\\xb6L\\x9b\\xb7\\x1d\\xbb\\xd0\\xbf/E\\xd6\\xdb,\\x97j\\x8c\\x85x\\x93\\xcc\\xdd\\x81\\xc8\\x9d\\xa2\\x16\\xee0\\x98\\xda\\xa0\\xc2\\x11\\xee*\\\''U
      -\\xc1\\x12,\\x84\\xf7\\xcf\\xa12,\\xd8\\xf7\\x0e\\x8b\\xb3\\xbf\\xc8\\x89\\x05\\x0c\\x87\\xb0\\x1c\\xdf\\x15\\xf8E\\xfa\\xd3\\xc6\\xc1\\xe4:\\x8f\\xafg/}[\\xdf\\xcc6\\x96\\xd8\\x14\\x1c\\x8e\\x93\\xee\\tm\\x15\\xc3\\xf8\\xf0\\x1f\\xee9\\xfcy\\xfb\\\''\\xaa\\x81t\\xfbS\\x87c\\xcf\\xf4\\xbb\\x97\\xe9\\xe3\\xa5\\xe6\\x05%\\xe9O\\xe0b^\\x13}*_\\x80\\xae\\xc1\\xe4\\x1b\\xca\\x9c%#\\xeeE+\\xfbQ\\xfc\\x12l\\xa6i\\x16\\xf2\\xc6\\xff\\xac\\xd5\\x10\\xacM\\xa2\\xef\\x99\\x1bi\\xda\\xb3\\x93%\\xb9\\x99<\\x83\\x1fI2\\x18O\\xb0:\\xee4~\\x91\\x10~\\xec\\xeal\\r5\\xedn\\x12f\\xdaF\\xb8a\\x84\\x99\\x18\\x97\\x8eP\\xe4@t\\x9d\\x14\\xa7i\\xcd\\xf6\\x8dU:\\xfffk\\xaf\\xc7\\x8aM\\xdd\\xe1\\xc8IC\\xde\\xf1\\xdb\\xe7\\x11?\\x92}\\xc8\\x8c~\\x1ccd,\\x10\\xa7\\x97\\xceq]\\x91f?\\x85\\xe3\\xe7\\x14\\x82\\xdfrY\\x0f\\x99\\x19\\x15i<\\xd3I\\x80\\xc7\\xbb\\x01\\xe9\\xb5\\x0f\\xb1\\xb0h\\xbc\\xcc\\xea]\\x88\\xc9?\\xdbsV\\xfd\\xa0\\xb8\\xaf9X\\xfd76\\rk\\xd6\\xca\\xaa:B.\\x97\\xe9-\\x9d!\\x93\\xbf\\x0c\\xf1\\xe7\\x03\\xe2b\\x84\\xb0_|\\xb2\\xf484\\x86;\\x10u\\xc3a\\x82\\xfd&E\\xd0n\\xfaX\\xb4\\t\\x93\\xc5lk\\x1e\\x9eYr\\xa0N\\xc3|\\x8c\\xc2\\xbf\\xdfq\\xe3\\\\\\xb20\\xc53\\x11>\\xae\\xb5\\xcf\\x7f7\\x9f&+[\\xe3\\x03E`\\xbf\\xd4\\xc6\\x08UM\\xea\\xb1\\x1e;\\xd6\\x035L^C\\xe7m\\x07Xw\\x08\\xed\\xd6\\xcc\\xb1S4\\xee\\xc41q\\xdd\\x13\\xcd\\x94\\xc5\\xd8\\xde\\x99[G\\x0f\\x02UZ\\x90\\x87G\\x10\\x137Lk^\\x0b-,\\x04\\xb0\\xad}\\xcd\\xf3\\xc4^\\xb9\\x12\\x81x\\xae{v7\\n\\x82\\x08\\xee\\x92\\xee\\xf0\\x15b\\xf4\\x07\\xa9\\x8b\\x02+\\x062:\\x8d\\xd1\\xf3\\x98\\xb8\\x9d\\x86\\x02l\\xc9\\x9d\\xee\\xe0(H\\x07\\xfe\\xec\\xda\\xe0\\xc7\\x11r\\xfc)\\xfb\\xe7\\xf4\\x9d/\\x94\\xab\\xd2\\r\\xd1\\xb0!\\xaf\\xfd\\x13\\xa6e\\xf2\\x8a{\\xf1&\\xda\\x06#\\x98\\xbb\\xa84?\\xe5\\xd0\\x00+\\xc7\\xfb_\\x13w\\xc4Y=\\x05\\x02_\\xf2\\xe0:\\x8e(\\xc9tk6\\xb8\\nW\\xc0+m\\xbd\\xfb\\xdd\\xb9\\xc3\\xbd5\\xc5\\\''"e\\x94g_\\xc6\\xa6b=*\\xfcF_)Y1u\\xb6\\xed\\xbc^\\xb0\\xc1\\x1f.\\xbb\\xdb\\xe4\\xa1O#\\x8a{\\xff\\xf5\\x06D\\xfc