- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: bytes to packets block\n\"\"\"\n\
      \nfrom random import randbytes\nimport pmt\nfrom pathlib import Path\n\nfrom\
      \ reedsolo import RSCodec\nfrom gnuradio import gr\nimport numpy as np\n\n\n\
      def importFileFromPath(path):\n    \"\"\"import file as binary\n\n    Args:\n\
      \        path (str): file path\n\n    Returns:\n        data (bytes): output\
      \ file\n    \"\"\"\n    with open(path, 'rb') as f:\n        data = f.read()\n\
      \    return data\n\n\ndef split_into_chuncks(data, chunck_size):\n    \"\"\"\
      takes some binary data and split it into chuncks\n\n    Args:\n        data\
      \ (bytes): input data\n        chunck_size (int): chunck size in bytes\n\n \
      \   Yields:\n        bytes: chunck\n    \"\"\"\n    for i in range(0, len(data),\
      \ chunck_size):\n        yield data[i:i + chunck_size]\n\n\n\ndef binary_to_encoded_packet(binaryFile,\n\
      \                             packet_size=64,\n                            \
      \ preamble_size = 3,\n                             postamble_size = 3,\n   \
      \                          ecc_size=6,\n                             id_len=2,\n\
      \                             data_len=1,\n                             verbose=False):\n\
      \    \"\"\"takes a binary file and split it into encoded packets.\n\n    each\
      \ packet is formatted like so, before Reed Solomon Encoding:\n    [ID, data_length,\
      \ data]\n\n    Args:\n        binaryFile (bytes, str): input binary file\n \
      \       packet_size (int, optional): total packet size in bytes. Defaults to\
      \ 64.\n        preamble_size(int, optionnal): preamble size in packet.\n   \
      \     postamble_size(int, optionnal): postamble size in packet.\n        ecc_size\
      \ (int, optional): Error Correction Code length. Defaults to 5.\n        id_len\
      \ (int, optional): id descriptor length. (With 2 bytes, 65535 packet can be\
      \ identified at most). Defaults to 2.\n        data_len (int, optional): data\
      \ length descriptor length. (with 1 byte, max packet size is 255). Defaults\
      \ to 1.\n        verbose (bool, optional): if true, you get to know the ecc\
      \ performance.\n    Returns:\n        output (np.uint8): output packets\n  \
      \  \"\"\"\n    if isinstance(binaryFile, str):\n        path = Path(binaryFile)\n\
      \        if path.is_file():\n            binaryFile = importFileFromPath(path)\n\
      \        else:\n            raise FileExistsError\n    elif isinstance(binaryFile,\
      \ bytes):\n        pass\n    else:\n        raise TypeError\n\n    ecc = RSCodec(ecc_size)\n\
      \    ecc.maxerrata(verbose=verbose)\n\n    chuncks = split_into_chuncks(binaryFile,\n\
      \                                 packet_size - ecc_size - id_len - data_len)\n\
      \    \n    preamble = [(0).to_bytes(id_len, 'big') + randbytes(packet_size -\
      \ id_len)] * preamble_size\n    postamble = [(0).to_bytes(id_len, 'big') + randbytes(packet_size\
      \ - id_len)] * postamble_size\n\n    chunck_with_id = preamble + [(i+1).to_bytes(id_len,\
      \ 'big') +\n                                 len(c).to_bytes(data_len, 'big')\
      \ + c\n                                 for i, c in enumerate(chuncks)] + postamble\n\
      \n    while len(chunck_with_id[-1]) < packet_size - ecc_size:\n        chunck_with_id[-1]\
      \ += randbytes(1)\n\n    encoded_chuncks = [ecc.encode(c) for c in chunck_with_id]\n\
      \n    output = [np.frombuffer(ec, dtype=np.uint8) for ec in encoded_chuncks]\n\
      \n    return output\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 input_binary=randbytes(1000),\n                 packet_size=64,\n\
      \                 preamble_size=3,\n                 postamble_size=3,\n   \
      \              ecc_size=6,\n                 id_len=2,\n                 data_len=1):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Binary\
      \ to Packet',\n            in_sig=None,\n            out_sig=[np.uint8]\n  \
      \      )\n        self.packet_size = packet_size\n        self.out_packets =\
      \ binary_to_encoded_packet(input_binary,\n                                 \
      \                   preamble_size,\n                                       \
      \             postamble_size,\n                                            \
      \        packet_size,\n                                                    ecc_size,\n\
      \                                                    id_len,\n             \
      \                                       data_len)\n        self.current_packet_index\
      \ = 0\n        self.indx = 0\n        self.packet_count = len(self.out_packets)\n\
      \        self.eof = False\n\n    def work(self, input_items, output_items):\n\
      \        if not self.eof:\n            if self.current_packet_index <= self.packet_count:\n\
      \                output_items[0][:self.packet_size] = self.out_packets[self.current_packet_index]\n\
      \                self.current_packet_index += 1\n\n                packet_length\
      \ = len(output_items[0])\n                key = pmt.intern(\"packet_len\")\n\
      \                val = pmt.from_long(packet_length)\n                self.add_item_tag(0,\
      \  # Write to output port 0\n                                self.indx,   #\
      \ Index of the tag\n                                key,   # Key of the tag\n\
      \                                val,\n                                srcid=pmt.PMT_F)\n\
      \                self.indx += packet_length\n                return packet_length\n\
      \            else:\n                self.eof = True\n                return\
      \ 0\n        else:\n            return 0\n\n\nif __name__ == \"__main__\":\n\
      \    test = blk()\n"
    affinity: ''
    alias: ''
    comment: ''
    data_len: '1'
    ecc_size: '6'
    id_len: '2'
    input_binary: '"/home/bimbim/Codes/vibe_5/sampleFile.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_size: '64'
    postamble_size: '3'
    preamble_size: '3'
  states:
    _io_cache: ('Binary to Packet', 'blk', [('input_binary', 'b\'wy\\x15\\x1a\\x9d\\x08\\xcb\\xba\\xe3I\\x7f\\x94.U\\x8f\\xcaMnw\\x9b\\x926\\xfc\\xb2%!})-\\x94\\xd8<l\\x01)\\x0e,\\xa0`\\x02\\x0b\\x87\\xc6q\\x8e\\xceXs\\xbd\\xf4\\xc4\\x95\\x01H+\\x96z\\xb9\\xb2\\xd1D\\xd6\\x03\\x0f\\xac\\xc5\\xebT$\\xe9\\xdc\\xf0\\xf4\\x0e"\\x7f\\xde[\\xc4\\x19\\xfc\\xcbw\\xc8\\xe5c_\\xde\\x19*8\\xe4v>l&\\x9e\\xa9\\xb6/\\xf5\\xb4\\x95\\x14%9\\xbc\\x06gg\\xd1\\xa1\\xaf\\xe2\\x99wTsY9U\\x04\\x87\\xdbqz\\xbd\\xe0\\xc5G\\x94\\x7f\\x02\\x92\\x94\\n_w\\xef\\x9c\\xf2\\xb8v\\xc1\\xb2\\xf2\\x08\\xe7WZJ#\\x15\\x0f\\x95l\\x8e\\x11\\xf2\\xe0U\\x14\\x02si\\xday"\\xac\\x0e\\xac\\xba\\xc5\\xe8\\x0fZ\\x97\\x7f\\xeb\\x9b\\x05\\x9a\\x9f=\\xd7\\xb1\\x0b\\xcd\\xe7$\\xf2WoZ\\x8b\\x8a\\x12\\xb9\\x0b\\xf6\\xc5\\x1agx\\x02\\x03\\x05\\xf4\\xf8\\xb3\\x1c
      ?\\x89Ax\\x9fE\\xc5\\x17\\xd4E\\x0ed\\xa5\\xad[\\x86\\xd2G\\x9ct\\xa3d\\xabM\\xee{\\x9d\\xae\\xadv3\\x06P\\x98/\\xd3\\xb4\\x02\\xba\\x19\\xae\\xff\\xb7\\xe0\\xf79T\\xa8\\x0c\\x06\\x9e\\xa0\\x98P\\x9b\\xff\\xd4D\\xfeo\\xd6T\\x1dx\\x08
      /\\xfdh>>\\xb9x\\xed0\\x07>\\xe0K\\x1c\\x86!%q\\x17\\xaeU\\xa5\\xb2\\x80\\x89\\xd0\\xcc\\xca\\x0b\\xa9}\\x03@\\x969\\xf9\\x18\\xd2\\xd0R\\x04Zkch\\x04\\xc3\\x02\\x14(\\xb5\\x97\\xf2Rop\\x96\\x01\\xd0\\xac\\x9c\\x87\\x14`p\\xd0v\\xe1e\\x8bS\\xeaW\\x14)\\xcbt\\xcf\\xeb\\xab\\x1f\\xeb\\x10L\\xb4\\xa28\\x04*3\\x1b)?\\xd5>\\x15\\x8d\\xd1
      \\xa4;]k\\xbf:\\xbc\\x9f\\x99\\xd0\\xc3\\x0c\\x15\\xd3\\x12t\\x15\\xefA\\xce\\x04$\\x0c\\xc9|p\\x90\\x9d\\x18!\\x88\\x93\\xb0{\\x1a\\xae\\xad\\xf8\\xec\\xec\\xcf\\x0ffp\\x04A\\xa1\\x1e\\xe8\\xf1\\x13\\xa8\\xe3\\xe0\\xb1\\xd6IJ0\\x9c\\x8dZ\\xb6^\\xd1\\xd9Cc4\\x19V1\\xf3>\\xea\\xaa\\xe9\\x13~k\\xf3+\\x0be\\xcb\\xcc\\xc4\\xe7\\xd7\\xf8"\\x94\\xb8@\\xd7\\xc7\\xcc\\xa3\\xc0fPck\\xfeAoS\\xe1I\\x1e\\x93\\xd1|.Nl\\xa7G\\xdc\\xaf\\xb1\\\\\\x01\\xeb\\xf5?\\x0b\\x00\\xbf&\\x7f\\x91\\xdc\\x00@\\xabt7\\x9b\\x8f\\x17\\xad\\xb9\\xdf\\xf4y\\x97\\n\\xe6\\xa8\\xab\\x1a\\xd7\\x88\\xddU;\\xcf,/R\\x16\\x0e\\xdf\\x8fDO4s|D\\xd1\\xb0B2@:\\xc4\\x974\\xb5\\x9eYX*/\\tW\\x8a\\xad\\x9c\\x13S\\xcand\\x05aD|?*\\x19\\xb5\\xd8\\x1c\\xa3tm\\x10\\x1a=Ni\\x8e\\x86\\xb7\\xd3,\\x9a&\\x18\\x8d~C\\x14\\xf2\\xc8S\\xb1\\x18\\xb7\\x07\\xfb\\xc6c\\xab\\xa0\\x8ct\\x99e\\x97w\\xa8a\\xfe\\x94B\\xb3\\xd5\\xfa\\xbcJ\\x9b\\x0f\\x1bGu\\xc0\\xac$\\xcfm`y$\\t\\x8bC\\xc7\\xbd\\xf7\\x16\\xf1\\x18k\\x95\\xfd\\x9cj@@\\x05p\\x01W\\xbef_\\x98/\\x9d4\\xe5\\x95\\xd3\\x99\\xd8\\x8e\\xabM_\\xd1Ac\\xfd\\x83\\x84\\x9f\\xdc\\xed\\xcc\\xb5\\x98\\xd1iu&\\xeb\\xd2rP\\xf7\\xdc\\x0c\\xd3\\xd6\\x86\\r>\\xc6\\x91aV\\xa2f:\\x85\\t\\x0f\\xe8!\\xd0\\xbc\\x84EP\\xc7\\xd8d\\x13DC\\x0e\\xc8\\x8c\\xa2\\x1d\\x90\\x98\\xb8N\\x03\\x8bc\\xc0{v@X\\xbd\\xfeS\\x02h\\x9b\\xa19X\\xbe\\xadY\\x07\\x7f_ph\\xe8\\x07w}s_\\xfe:\\xd0\\x8e%juW\\x7fY\\xe9\\xcb&\\x08>F]\\xdbi\\xb8|]\\xfa\\xb2\\x9bg\\xa1\\x8a\\xef\\xc8\\xa2\\xcd\\x8a\\xf1\\x91\\xe53\\x1e\\xecr\\x9d/\\x96\\x86\\\'\\x91\\xbe#\\x96\\x06
      8\\xf3h\\x98\\xc9\\x94\\xc0\\xaeeN&,z\\x89\\t\\xdcn\\xfeZ\\xe7\\x8c\\x94\\\'\\xd4\\xdf\\x04\\x0e\\xcf\\xac\\xc3\\x058\\xf5e\\x81\\x7f\\x07m\\xeb\\x1bA\\xe1\\xbc\\x11\\x9c\\x98]w\\xf24\\xb5T\\xb5t\\x1b\\xc7\\x8e%\\xd6\\xfa\\xb1\\x17\\x18\\x0b\\xfb\\xdb\\xc4O\\x00%w\\xdc\\xe6\\x16\\x1a\\x9e[$\\x06\\x04\\xa5I\\xe4@\\xbf\\xfb\\xf7\\xbe\\xadQ\\x0b\\xb1+3N\\x9e8?T\\x00\\xf8)McR\\xaa$\\x9c\\x04\\xa9b\\x03\\xceE\\xc1\\xd5\\x88b\\xb5\\xac\\xccL<\\xf7\\\'\\xc8y\\xb3B\\xc0\\x16}\\x05|HRzw>O\\xc9\\n~\\x93\\xbdWS\\xf0\\xdf3w?\\xa8\\xbcB\\x1f\\x17\\xba\\xd047V\\xb2\\xffo\\xc1}\\x90\\x01\\x8d\\\'\\xe2\\xde\\xafk\\xa0\\xb6t\''),
