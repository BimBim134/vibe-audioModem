- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport warnings\nimport\
      \ base64\n\nimport numpy as np\nfrom gnuradio import gr\nfrom reedsolo import\
      \ RSCodec, ReedSolomonError\nimport pmt\n\ndef decode_single_packet(packet,\n\
      \                         ecc,\n                         id_len,\n         \
      \                data_len):\n    \"\"\"takes a single packet and decode it.\n\
      \n    Args:\n        packet (bytes): input packet\n        ecc (RSCodec): Reed\
      \ Solomon Encoder\n        id_len (int): id descriptor length\n        data_len\
      \ (int): data length descriptor length\n\n    Returns:\n        id, data (int,\
      \ bytes): packet id, packet data\n    \"\"\"\n    try:\n        decoded_packet\
      \ = ecc.decode(packet)[0]\n        id = int.from_bytes(decoded_packet[:id_len],\
      \ 'big') - 1\n        d_len = int.from_bytes(decoded_packet[id_len:id_len +\
      \ data_len], 'big')\n        if id == -1: # filter out the preamble and postamble\n\
      \            if b'eof' in decoded_packet:\n                return (-1, b'eof')\n\
      \            else:\n                return (-1, decoded_packet[id_len + data_len:id_len\
      \ + data_len + d_len])\n        else:\n            return (id, decoded_packet[id_len\
      \ + data_len:id_len + data_len + d_len])\n    except ReedSolomonError as e:\n\
      \        warnings.warn(\"packet is corrupted beyond repair !\")\n        print(e)\n\
      \        return (-1, packet)\n\nclass blk(gr.basic_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    def __init__(self,\n     \
      \            out_filename='',\n                 packet_size=64,\n          \
      \       ecc_size=6,\n                 id_len=2,\n                 data_len=1,\n\
      \                 verbose=False):\n        gr.basic_block.__init__(\n      \
      \      self,\n            name='Packets to Binaries',\n            in_sig=[np.uint8],\n\
      \            out_sig=None\n        )\n        self.out_filename = out_filename\n\
      \        self.packet_size = packet_size\n        self.ecc = RSCodec(ecc_size)\n\
      \        self.ecc.maxerrata(verbose=verbose)\n        self.id_len = id_len\n\
      \        self.data_len = data_len\n\n        self.packets = {}\n\n        self.packet_count\
      \ = 0\n        self.eof = False\n\n    \n    def save_file(self):\n        data\
      \ = dict(sorted(self.packets.items()))\n\n        received_ids = set(data.keys())\n\
      \        check_id = set(range(len(data)))\n        if received_ids != check_id:\n\
      \            warnings.warn(\"data may be incomplete !\", BytesWarning)\n\n \
      \       data = list(data.values())\n        output = b''.join(data)\n      \
      \  output = base64.urlsafe_b64decode(output)\n        with open(self.out_filename,\
      \ 'wb') as f:\n            f.write(output)\n\n    def general_work(self, input_items,\
      \ output_items):\n        if not self.eof:\n            in0 = input_items[0]\n\
      \            tags = self.get_tags_in_window(0, 0, len(in0))\n\n            packet_start\
      \ = 0\n            for tag in tags:\n                if tag.key == pmt.string_to_symbol(\"\
      packet_len\"):\n                    packet_len = pmt.to_long(tag.value)\n  \
      \                  packet_end = packet_start + packet_len\n\n              \
      \      if packet_end <= len(in0):\n                        raw_packet = in0[packet_start:packet_end]\n\
      \n                        id, packet_data = decode_single_packet(raw_packet,\n\
      \                                                            self.ecc,\n   \
      \                                                         self.id_len,\n   \
      \                                                         self.data_len)\n \
      \                       if len(packet_data) > 0:\n                         \
      \   packet_start = packet_end\n                            self.consume(0, packet_start)\n\
      \                            if not id == -1:\n                            \
      \    # saving data\n                                gr.log_debug.info(f\"receiving\
      \ packet {id:0>6d} : {len(packet_data)}\")\n                               \
      \ self.packets[id] = packet_data\n                                return 0\n\
      \                            else:\n                                # checking\
      \ if it is EOF\n                                gr.log_debug.info(f\"receiving\
      \ packet pre/postamble : {len(packet_data)}\")\n                           \
      \     if b'eof' in packet_data:\n                                    gr.log_debug.info(\"\
      receving EOF\")\n                                    self.eof = True\n     \
      \                               self.save_file()\n                         \
      \           gr.log_debug.info(f'saving file to {self.out_filename}')\n     \
      \                           return 0\n                        else:\n      \
      \                      gr.log_debug.info(\"no data in packet\")\n          \
      \                  return 0\n\n                    else:\n                 \
      \       gr.log_debug.info(\"packet not complete, waiting for more data\")\n\
      \                        return 0              \n                else:\n   \
      \                 gr.log_debug.info(f'unknown tag {tag.key}')\n            \
      \        return 0\n        return -1 # Return -1 to indicate end of file\n\n\
      if __name__ == \"__main__\":\n    test = blk()"
    affinity: ''
    alias: ''
    comment: ''
    data_len: '1'
    ecc_size: '10'
    id_len: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    out_filename: output_file_path
    packet_size: packet_size
    verbose: 'False'
  states:
    _io_cache: ('Packets to Binaries', 'blk', [('out_filename', "''"), ('packet_size',
      '64'), ('ecc_size', '6'), ('id_len', '2'), ('data_len', '1'), ('verbose', 'False')],
      [('0', 'byte', 1)], [], '', ['data_len', 'id_len', 'out_filename', 'packet_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4272, 304.0]
    rotation: 0
    state: enabled
