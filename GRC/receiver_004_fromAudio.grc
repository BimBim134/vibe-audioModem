    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: receiver 004 from Audio
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

