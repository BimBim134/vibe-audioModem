options:
  parameters:
    author: bimbim
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: peak_detector
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: peak_detector
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '44100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: audio_source_0_0
  id: audio_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_name: plughw:0,0
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    ok_to_block: 'True'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 144.0]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1024'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 152.0]
    rotation: 0
    state: enabled
- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '1024'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 160.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nfrom scipy.signal\
      \ import find_peaks\n\nclass blk(gr.sync_block):\n    \"\"\"Peak Frequency Detector\"\
      \"\"\n\n    def __init__(self, sample_rate=48000, fft_size=1024, threshold=10):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Peak\
      \ Frequency Detector',\n            in_sig=[(np.float32, fft_size)],  # Accepts\
      \ vector of fft_size elements\n            out_sig=None\n        )\n       \
      \ self.sample_rate = sample_rate\n        self.fft_size = fft_size\n       \
      \ self.threshold = threshold\n\n    def work(self, input_items, output_items):\n\
      \        for spectrum in input_items[0]:  # Iterate over vector batches\n  \
      \          freqs = np.fft.rfftfreq(self.fft_size, 1.0 / self.sample_rate)\n\n\
      \            # Find all local peaks above threshold\n            peaks, props\
      \ = find_peaks(spectrum, height=self.threshold)\n\n            if peaks.size\
      \ > 0:\n                max_peak_idx = peaks[np.argmax(props['peak_heights'])]\n\
      \                peak_freq = freqs[max_peak_idx]\n                print(f\"\
      Detected Peak Frequency: {peak_freq:.2f} Hz\")\n            else:\n        \
      \        print(\"No peak detected above threshold.\")\n        \n        return\
      \ len(input_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    fft_size: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: '48000'
    threshold: '10'
  states:
    _io_cache: ('Peak Frequency Detector', 'blk', [('sample_rate', '48000'), ('fft_size',
      '1024'), ('threshold', '10')], [('0', 'float', 1024)], [], 'Peak Frequency Detector',
      ['fft_size', 'sample_rate', 'threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 136.0]
    rotation: 0
    state: enabled
- name: fft_vxx_0
  id: fft_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fft_size: '1024'
    forward: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    nthreads: '1'
    shift: 'True'
    type: float
    window: window.blackmanharris(1024)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 120.0]
    rotation: 0
    state: enabled

connections:
- [audio_source_0_0, '0', blocks_stream_to_vector_0, '0']
- [blocks_complex_to_mag_0, '0', epy_block_0, '0']
- [blocks_stream_to_vector_0, '0', fft_vxx_0, '0']
- [fft_vxx_0, '0', blocks_complex_to_mag_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.10.0
