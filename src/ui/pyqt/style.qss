/* ===================================================
   Vibe Audio Modem — Modern Dark Theme (Light variant)
   =================================================== */

/* ---- Global ---- */
QWidget {
    background-color: #252830;
    color: #dce4f5;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
}

QMainWindow {
    background-color: #252830;
}

/* ---- GroupBox ---- */
QGroupBox {
    background-color: #2b2f3a;
    border: 1px solid #3d4158;
    border-radius: 8px;
    margin-top: 18px;
    padding: 10px 8px 8px 8px;
    font-weight: 600;
    color: #92bfff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -1px;
    padding: 0 6px;
    background-color: #252830;
    color: #92bfff;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* ---- Labels ---- */
QLabel {
    color: #b8c4da;
    background-color: transparent;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #92bfff;
    color: #1a1d23;
    border: none;
    border-radius: 6px;
    padding: 6px 18px;
    font-weight: 700;
    font-size: 12px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #b4d4ff;
}

QPushButton:pressed {
    background-color: #6a9ed8;
}

QPushButton:disabled {
    background-color: #3d4158;
    color: #686d88;
}

/* ---- Text Edit / Plain Text Edit ---- */
QTextEdit, QPlainTextEdit {
    background-color: #1e2128;
    color: #dce4f5;
    border: 1px solid #3d4158;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #505471;
    selection-color: #dce4f5;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    line-height: 1.4;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #92bfff;
}

/* ---- Line Edit ---- */
QLineEdit {
    background-color: #1e2128;
    color: #dce4f5;
    border: 1px solid #3d4158;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 24px;
    selection-background-color: #505471;
}

QLineEdit:focus {
    border: 1px solid #92bfff;
}

QLineEdit:disabled {
    background-color: #2b2f3a;
    color: #686d88;
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: #1e2128;
    color: #dce4f5;
    border: 1px solid #3d4158;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
}

QComboBox:hover {
    border: 1px solid #92bfff;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #92bfff;
}

QComboBox QAbstractItemView {
    background-color: #2b2f3a;
    color: #dce4f5;
    border: 1px solid #3d4158;
    border-radius: 6px;
    selection-background-color: #3d4158;
    selection-color: #92bfff;
    padding: 2px;
    outline: none;
}

/* ---- SpinBox / DoubleSpinBox ---- */
QDoubleSpinBox, QSpinBox {
    background-color: #1e2128;
    color: #dce4f5;
    border: 1px solid #3d4158;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 24px;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #92bfff;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #3d4158;
    border: none;
    width: 16px;
    border-radius: 3px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #505471;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background-color: #1e2128;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #505471;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #686d88;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1e2128;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #505471;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #686d88;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #3d4158;
}

/* ---- Frame ---- */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #3d4158;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #1e2128;
    color: #686d88;
    border-top: 1px solid #3d4158;
    font-size: 11px;
}

/* ---- Tooltip ---- */
QToolTip {
    background-color: #3d4158;
    color: #dce4f5;
    border: 1px solid #505471;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---- PyQtGraph PlotWidget override ---- */
pg--PlotWidget {
    background-color: #1e2128;
    border: 1px solid #3d4158;
    border-radius: 6px;
}

pg--GraphicsLayoutWidget {
    background-color: #1e2128;
    border: 1px solid #3d4158;
    border-radius: 6px;
}
